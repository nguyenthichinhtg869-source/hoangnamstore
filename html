            orderSeq: 'hoangnam_store_v5_order_seq'
        };

        // Đọc bộ đếm số thứ tự đơn hàng an toàn (bắt đầu từ 0 -> đơn đầu tiên là HN001)
        function loadOrderSequence() {
            const rawSeq = parseInt(localStorage.getItem(STORAGE_KEYS.orderSeq) || '0', 10);
            const safeSeq = Number.isNaN(rawSeq) || rawSeq < 0 ? 0 : rawSeq;

            // Đồng bộ với các mã #HN001, #HN002... nếu đã có đơn hàng cũ trong danh sách
            let maxExistingNum = safeSeq;
            try {
                const existingOrders = JSON.parse(localStorage.getItem(STORAGE_KEYS.orders) || '[]');
                if (Array.isArray(existingOrders)) {
                    existingOrders.forEach(ord => {
                        const match = String(ord && ord.id ? ord.id : '').trim().match(/^#?HN(\d+)$/i);
                        if (match) {
                            const num = parseInt(match[1], 10);
                            if (!Number.isNaN(num) && num > maxExistingNum) {
                                maxExistingNum = num;
                            }
                        }
                    });
                }
            } catch (e) {
                // Giữ nguyên safeSeq nếu dữ liệu cũ không hợp lệ
            }

            return maxExistingNum;
        }

        // Sinh mã đơn tăng dần liên tục: HN001, HN002, HN003... (hiển thị thành #HN001...)
        function generateNextOrderCode() {
            const nextNum = (typeof state.orderSeq === 'number' && state.orderSeq >= 0 ? state.orderSeq : 0) + 1;
            state.orderSeq = nextNum;
            localStorage.setItem(STORAGE_KEYS.orderSeq, String(nextNum));
            const paddedNumber = String(nextNum).padStart(3, '0');
            return `HN${paddedNumber}`;
        }

        // Trạng thái ứng dụng
        let state = {
            users: JSON.parse(localStorage.getItem(STORAGE_KEYS.users) || '[]'),
            currentUser: localStorage.getItem(STORAGE_KEYS.currentUser) || null,
            guestBalance: parseInt(localStorage.getItem(STORAGE_KEYS.guestBalance) || '0', 10),
            cart: JSON.parse(localStorage.getItem(STORAGE_KEYS.cart) || '[]'),
            orders: JSON.parse(localStorage.getItem(STORAGE_KEYS.orders) || '[]'),
            orderSeq: loadOrderSequence(),
            category: 'all',
            couponApplied: false
        };

        // Lấy số dư hiện tại (theo tài khoản đang đăng nhập hoặc ví khách mặc định 0đ)
        function getCurrentBalance() {
            if (state.currentUser) {
                const userObj = state.users.find(u => u.username.toLowerCase() === state.currentUser.toLowerCase());
                return userObj ? (userObj.balance || 0) : 0;
            }
            return state.guestBalance || 0;
        }

        // Cập nhật số dư hiện tại
        function setCurrentBalance(newAmount) {
            const safeAmount = Math.max(0, Math.round(newAmount));
            if (state.currentUser) {
                const userObj = state.users.find(u => u.username.toLowerCase() === state.currentUser.toLowerCase());
                if (userObj) {
                    userObj.balance = safeAmount;
                }
            } else {
                state.guestBalance = safeAmount;
            }
            saveState();
        }

        function saveState() {
            localStorage.setItem(STORAGE_KEYS.users, JSON.stringify(state.users));
            if (state.currentUser) {
                localStorage.setItem(STORAGE_KEYS.currentUser, state.currentUser);
            } else {
                localStorage.removeItem(STORAGE_KEYS.currentUser);
            }
            localStorage.setItem(STORAGE_KEYS.guestBalance, String(state.guestBalance));
            localStorage.setItem(STORAGE_KEYS.cart, JSON.stringify(state.cart));
            localStorage.setItem(STORAGE_KEYS.orders, JSON.stringify(state.orders));
            localStorage.setItem(STORAGE_KEYS.orderSeq, String(state.orderSeq || 0));
            updateHeaderUI();
        }

        function formatVND(amount) {
            return Number(amount || 0).toLocaleString('vi-VN') + 'đ';
        }

        // Cập nhật giao diện Header & Avatar (AVT)
        function updateHeaderUI() {
            const currentBal = getCurrentBalance();
            const headerBal = document.getElementById('headerBalance');
            const cartWalletBal = document.getElementById('cartWalletBalance');
            const cartBadge = document.getElementById('cartBadgeCount');
            const orderBadge = document.getElementById('orderBadgeCount');

            if (headerBal) headerBal.textContent = formatVND(currentBal);
            if (cartWalletBal) cartWalletBal.textContent = formatVND(currentBal);

            const totalItems = state.cart.reduce((sum, item) => sum + item.qty, 0);
            if (cartBadge) cartBadge.textContent = totalItems;

            if (orderBadge) {
                if (state.orders.length > 0) {
                    orderBadge.textContent = state.orders.length;
                    orderBadge.classList.remove('hidden');
                } else {
                    orderBadge.classList.add('hidden');
                }
            }

            // Cập nhật nút Avatar trên Header
            const avatarCircle = document.getElementById('headerAvatarCircle');
            const avatarName = document.getElementById('headerAvatarName');
            const onlineDot = document.getElementById('headerOnlineDot');

            if (state.currentUser) {
                const initial = state.currentUser.trim().charAt(0).toUpperCase();
                if (avatarCircle) {
                    avatarCircle.innerHTML = initial;
                    avatarCircle.className = 'w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-gradient-to-br from-emerald-400 to-cyan-500 flex items-center justify-center text-slate-950 font-display font-extrabold text-xs shrink-0';
                }
                if (avatarName) avatarName.textContent = state.currentUser;
                if (onlineDot) onlineDot.classList.remove('hidden');
            } else {
                if (avatarCircle) {
                    avatarCircle.innerHTML = '<i class="fa-solid fa-user text-xs"></i>';
                    avatarCircle.className = 'w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-gradient-to-br from-cyan-400 via-blue-500 to-purple-600 flex items-center justify-center text-slate-950 font-display font-extrabold text-xs shrink-0';
                }
                if (avatarName) avatarName.textContent = 'Đăng nhập';
                if (onlineDot) onlineDot.classList.add('hidden');
            }
        }

        // ================= HỆ THỐNG ĐĂNG NHẬP & ĐĂNG KÝ TÀI KHOẢN (AVT) =================
        function openAuthOrProfileModal() {
            hideAuthFormAlert();
            const guestContainer = document.getElementById('authGuestContainer');
            const profileContainer = document.getElementById('authProfileContainer');
            const modalTitle = document.getElementById('authModalTitle');

            if (state.currentUser) {
