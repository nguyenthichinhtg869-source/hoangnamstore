                    </div>
                `;
                if (checkoutSection) checkoutSection.classList.add('hidden');
                if (footerAction) footerAction.classList.add('hidden');
                return;
            }

            if (checkoutSection) checkoutSection.classList.remove('hidden');
            if (footerAction) footerAction.classList.remove('hidden');

            let subtotal = 0;
            listEl.innerHTML = state.cart.map(item => {
                const product = PRODUCTS.find(p => p.id === item.id);
                if (!product) return '';
                const lineTotal = product.price * item.qty;
                subtotal += lineTotal;
                return `
                    <div class="p-3 rounded-2xl bg-gaming-bg border border-gaming-border flex items-center justify-between gap-2.5">
                        <div class="min-w-0 flex-1">
                            <div class="font-bold text-xs text-white truncate">${product.name}</div>
                            <div class="text-[11px] text-amber-400 font-semibold mt-0.5">${formatVND(product.price)} / gói</div>
                        </div>
                        <div class="flex items-center gap-1.5 shrink-0">
                            <button type="button" onclick="updateCartQty('${product.id}', -1)"
                                class="w-7 h-7 rounded-lg bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs flex items-center justify-center">-</button>
                            <span class="w-6 text-center text-xs font-bold text-white">${item.qty}</span>
                            <button type="button" onclick="updateCartQty('${product.id}', 1)"
                                class="w-7 h-7 rounded-lg bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs flex items-center justify-center">+</button>
                        </div>
                    </div>
                `;
            }).join('');

            const discount = state.couponApplied ? Math.round(subtotal * 0.1) : 0;
            const totalFinal = subtotal - discount;

            document.getElementById('cartSubtotal').textContent = formatVND(subtotal);
            const discountRow = document.getElementById('cartDiscountRow');
            if (state.couponApplied && discount > 0) {
                discountRow.classList.remove('hidden');
                document.getElementById('cartDiscountAmount').textContent = `-${formatVND(discount)}`;
            } else {
                discountRow.classList.add('hidden');
            }
            document.getElementById('cartTotalFinal').textContent = formatVND(totalFinal);
            document.getElementById('cartWalletBalance').textContent = formatVND(getCurrentBalance());
        }

        function processCheckout() {
            if (state.cart.length === 0) return;

            const username = (document.getElementById('robloxUsername')?.value || '').trim();
            if (!username) {
                showToast('Vui lòng nhập Tên nhân vật / Username Roblox để nhận hàng!', 'error');
                document.getElementById('robloxUsername')?.focus();
                return;
            }

            let subtotal = 0;
            const orderItems = [];
            state.cart.forEach(item => {
                const product = PRODUCTS.find(p => p.id === item.id);
                if (product) {
                    subtotal += product.price * item.qty;
                    orderItems.push(`${product.name} (x${item.qty})`);
                }
            });

            const discount = state.couponApplied ? Math.round(subtotal * 0.1) : 0;
            const finalTotal = subtotal - discount;
            const method = document.querySelector('input[name="paymentMethod"]:checked')?.value || 'balance';
            const currentBal = getCurrentBalance();

            if (method === 'balance') {
                if (currentBal < finalTotal) {
                    showToast(`Số dư không đủ (${formatVND(currentBal)}), vui lòng nạp thêm tiền!`, 'error');
                    closeModal('cartModal');
                    openModal('topupModal');
                    return;
                }
                setCurrentBalance(currentBal - finalTotal);
            }

            const newOrder = {
                id: generateNextOrderCode(),
                items: orderItems.join(', '),
                username: state.currentUser ? `${username} (${state.currentUser})` : username,
                total: finalTotal,
                method: method === 'balance' ? 'Số dư tài khoản' : 'Chuyển khoản QR Bản Việt',
                status: 'Đang xử Lí',
                paidByBalance: method === 'balance',
                refunded: false,
                time: new Date().toLocaleString('vi-VN')
            };

            state.orders.unshift(newOrder);
            state.cart = [];
            state.couponApplied = false;
            saveState();
            renderCart();
            closeModal('cartModal');

            showToast(
                `Đã tạo đơn #${newOrder.id} (${newOrder.status})! Xem tiến độ trong mục Chi tiết đơn hàng.`,
                'success'
            );
        }

        // ================= NẠP TIỀN (QR & THẺ CÀO) =================
        function switchTopupTab(tab) {
            const qrPanel = document.getElementById('topupQrPanel');
            const cardPanel = document.getElementById('topupCardPanel');
            const tabQr = document.getElementById('tabTopupQr');
            const tabCard = document.getElementById('tabTopupCard');

            if (tab === 'qr') {
                qrPanel.classList.remove('hidden');
                cardPanel.classList.add('hidden');
                tabQr.className = 'py-2 px-3 rounded-xl text-xs font-extrabold bg-cyan-500 text-slate-950 flex items-center justify-center gap-1.5 transition-all';
                tabCard.className = 'py-2 px-3 rounded-xl text-xs font-bold text-slate-300 hover:text-white flex items-center justify-center gap-1.5 transition-all';
            } else {
                qrPanel.classList.add('hidden');
                cardPanel.classList.remove('hidden');
                tabCard.className = 'py-2 px-3 rounded-xl text-xs font-extrabold bg-amber-500 text-slate-950 flex items-center justify-center gap-1.5 transition-all';
                tabQr.className = 'py-2 px-3 rounded-xl text-xs font-bold text-slate-300 hover:text-white flex items-center justify-center gap-1.5 transition-all';
            }
        }

        function quickTopup(amount) {
            setCurrentBalance(getCurrentBalance() + amount);
            state.orders.unshift({
                id: generateNextOrderCode(),
                items: `Nạp tiền QR Ngân Hàng Bản Việt (+${formatVND(amount)})`,
                username: state.currentUser || 'Khách hàng',
                total: amount,
                method: 'Chuyển khoản QR',
                status: 'Đã Hoàn Thành',
                paidByBalance: false,
                refunded: false,
                time: new Date().toLocaleString('vi-VN')
            });
            saveState();
            renderCart();
            showToast(`Nạp thành công +${formatVND(amount)}! Số dư hiện tại: ${formatVND(getCurrentBalance())}`, 'success');
        }

        function handleCardTopup(event) {
            event.preventDefault();
            const telco = document.getElementById('cardTelco').value;
            const amount = parseInt(document.getElementById('cardAmount').value, 10) || 0;
            const serial = document.getElementById('cardSerial').value.trim();
            const pin = document.getElementById('cardPin').value.trim();

            if (!serial || !pin) {
                showToast('Vui lòng nhập đầy đủ Số Seri và Mã thẻ!', 'error');
                return;
            }

            setCurrentBalance(getCurrentBalance() + amount);
            state.orders.unshift({
                id: generateNextOrderCode(),
                items: `Nạp thẻ ${telco} ${formatVND(amount)} (Seri: ${serial})`,
                username: state.currentUser || 'Khách hàng',
                total: amount,
                method: `Thẻ cào ${telco}`,
                status: 'Đã Hoàn Thành',
                paidByBalance: false,
                refunded: false,
                time: new Date().toLocaleString('vi-VN')
            });

            document.getElementById('cardSerial').value = '';
            document.getElementById('cardPin').value = '';
            saveState();
            renderCart();
            closeModal('topupModal');
            showToast(`Nạp thẻ ${telco} thành công! Cộng +${formatVND(amount)} vào ví.`, 'success');
        }

        // ================= ĐIỀU KHIỂN MODAL & TOAST =================
        function openModal(modalId) {
            const modal = document.getElementById(modalId);
            if (!modal) return;
            if (modalId === 'cartModal') renderCart();
            if (modalId === 'ordersModal') renderOrdersModal();
            modal.classList.remove('hidden');
        }

        function closeModal(modalId) {
            const modal = document.getElementById(modalId);
            if (modal) modal.classList.add('hidden');
        }

        ['authModal', 'ordersModal', 'topupModal', 'cartModal', 'detailModal'].forEach(id => {
            const el = document.getElementById(id);
            if (el) {
                el.addEventListener('click', (e) => {
                    if (e.target === el) closeModal(id);
                });
            }
        });

        function showToast(message, type = 'success') {
            const container = document.getElementById('toastContainer');
            if (!container) return;
            const toast = document.createElement('div');
            const isError = type === 'error';

            toast.className = `pointer-events-auto p-3 rounded-xl border shadow-xl flex items-center gap-2.5 text-xs font-semibold transition-all duration-300 transform translate-y-2 opacity-0 ${
                isError
                    ? 'bg-rose-950/95 border-rose-500/60 text-rose-100'
                    : 'bg-slate-900/95 border-cyan-500/50 text-white'
            }`;

            toast.innerHTML = `
                <i class="fa-solid ${isError ? 'fa-circle-exclamation text-rose-400' : 'fa-circle-check text-cyan-400'} text-base shrink-0"></i>
                <span class="flex-1 leading-snug">${message}</span>
            `;

            container.appendChild(toast);
            requestAnimationFrame(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            });

            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 3400);
        }

        window.addEventListener('DOMContentLoaded', () => {
            updateHeaderUI();
            filterAndRenderProducts();
            renderCart();
        });
    </script>
</body>
</html>
