        function switchAuthTab(tab) {
            hideAuthFormAlert();
            const loginForm = document.getElementById('loginForm');
            const registerForm = document.getElementById('registerForm');
            const tabLogin = document.getElementById('tabLoginBtn');
            const tabReg = document.getElementById('tabRegisterBtn');

            if (tab === 'login') {
                loginForm.classList.remove('hidden');
                registerForm.classList.add('hidden');
                tabLogin.className = 'py-2 px-3 rounded-xl text-xs font-extrabold bg-gradient-to-r from-cyan-500 to-blue-600 text-slate-950 transition-all';
                tabReg.className = 'py-2 px-3 rounded-xl text-xs font-bold text-slate-300 hover:text-white transition-all';
            } else {
                loginForm.classList.add('hidden');
                registerForm.classList.remove('hidden');
                tabReg.className = 'py-2 px-3 rounded-xl text-xs font-extrabold bg-gradient-to-r from-emerald-400 to-cyan-500 text-slate-950 transition-all';
                tabLogin.className = 'py-2 px-3 rounded-xl text-xs font-bold text-slate-300 hover:text-white transition-all';
            }
        }

        function showAuthFormAlert(message, isError = true) {
            const alertBox = document.getElementById('authFormAlert');
            if (!alertBox) return;
            alertBox.className = `p-3 rounded-xl border text-xs font-semibold flex items-start gap-2 ${
                isError
                    ? 'bg-rose-950/80 border-rose-500/60 text-rose-200'
                    : 'bg-emerald-950/80 border-emerald-500/60 text-emerald-200'
            }`;
            alertBox.innerHTML = `
                <i class="fa-solid ${isError ? 'fa-circle-exclamation text-rose-400' : 'fa-circle-check text-emerald-400'} mt-0.5 shrink-0"></i>
                <span>${message}</span>
            `;
            alertBox.classList.remove('hidden');
        }

        function hideAuthFormAlert() {
            const alertBox = document.getElementById('authFormAlert');
            if (alertBox) alertBox.classList.add('hidden');
        }

        // Xử lý Đăng ký tài khoản (Kiểm tra trùng Username)
        function handleRegisterSubmit(event) {
            event.preventDefault();
            hideAuthFormAlert();

            const rawUsername = (document.getElementById('regUsername').value || '').trim();
            const password = document.getElementById('regPassword').value || '';
            const confirmPassword = document.getElementById('regConfirmPassword').value || '';

            if (!rawUsername) {
                showAuthFormAlert('Vui lòng nhập tên tài khoản!', true);
                return;
            }

            // Kiểm tra trùng tên không phân biệt chữ hoa/thường
            const isDuplicate = state.users.some(u => u.username.toLowerCase() === rawUsername.toLowerCase());
            if (isDuplicate) {
                const dupMsg = 'username này đã được đăng kí, vui lòng thay đổi';
                showAuthFormAlert(dupMsg, true);
                showToast(dupMsg, 'error');
                document.getElementById('regUsername').focus();
                return;
            }

            if (password !== confirmPassword) {
                showAuthFormAlert('Mật khẩu xác nhận không khớp, vui lòng nhập lại!', true);
                return;
            }

            // Tạo tài khoản mới với số dư mặc định 0đ
            state.users.push({
                username: rawUsername,
                password: password,
                balance: 0,
                createdAt: new Date().toLocaleString('vi-VN')
            });

            saveState();
            document.getElementById('regUsername').value = '';
            document.getElementById('regPassword').value = '';
            document.getElementById('regConfirmPassword').value = '';

            switchAuthTab('login');
            document.getElementById('loginUsername').value = rawUsername;
            showAuthFormAlert(`Đăng ký thành công tài khoản "${rawUsername}"! Hãy đăng nhập ngay.`, false);
            showToast(`Đăng ký thành công tài khoản "${rawUsername}"!`, 'success');
        }

        // Xử lý Đăng nhập tài khoản
        function handleLoginSubmit(event) {
            event.preventDefault();
            hideAuthFormAlert();

            const username = (document.getElementById('loginUsername').value || '').trim();
            const password = document.getElementById('loginPassword').value || '';

            const matchedUser = state.users.find(
                u => u.username.toLowerCase() === username.toLowerCase() && u.password === password
