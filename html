        function renderCart() {
            const listEl = document.getElementById('cartItemsList');
            const checkoutSection = document.getElementById('cartCheckoutSection');
            const footerAction = document.getElementById('cartFooterAction');

            if (!listEl) return;

            if (state.cart.length === 0) {
                listEl.innerHTML = `
                    <div class="text-center py-8 space-y-2">
                        <div class="w-12 h-12 rounded-2xl bg-slate-800/80 text-slate-400 flex items-center justify-center mx-auto text-lg">
