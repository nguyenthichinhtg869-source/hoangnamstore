<!DOCTYPE html>
<html lang="vi" class="dark scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>HoangNam Store - Shop Vật Phẩm PS99 & Acc Rank 20 Uy Tín</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Google Fonts: Space Grotesk & Be Vietnam Pro -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Be Vietnam Pro"', 'sans-serif'],
                        display: ['"Space Grotesk"', 'sans-serif'],
                    },
                    colors: {
                        gaming: {
                            bg: '#07090f',
                            card: '#0e1320',
                            cardHover: '#141c2f',
                            border: '#1e293b',
                            cyan: '#06b6d4',
                            blue: '#3b82f6',
                        }
                    },
                    boxShadow: {
                        'neon-cyan': '0 0 18px rgba(6, 182, 212, 0.32)',
                        'neon-blue': '0 0 20px rgba(59, 130, 246, 0.35)',
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #07090f;
            color: #f1f5f9;
            overflow-x: hidden;
            -webkit-tap-highlight-color: transparent;
        }
        ::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }
        ::-webkit-scrollbar-track {
            background: #07090f;
        }
        ::-webkit-scrollbar-thumb {
            background: #1e293b;
            border-radius: 999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #06b6d4;
        }
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
        .glass-header {
            background: rgba(7, 9, 15, 0.92);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col bg-gaming-bg text-slate-100 antialiased selection:bg-cyan-500/30 selection:text-cyan-200">

    <!-- ================= 1. HEADER & THANH TÌM KIẾM MOBILE-FIRST ================= -->
    <header class="sticky top-0 z-40 glass-header border-b border-gaming-border/90">
        <div class="max-w-6xl mx-auto px-3 sm:px-5 py-2.5">
            <!-- Hàng 1: Logo + Chi tiết đơn hàng + Ví tiền + Giỏ hàng + AVT Tài khoản -->
            <div class="flex items-center justify-between gap-1 sm:gap-2.5">
                <!-- Brand Logo -->
                <a href="#" onclick="resetFilters(); return false;" class="flex items-center gap-1.5 sm:gap-2 min-w-0 shrink">
                    <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-gradient-to-br from-cyan-400 to-blue-600 p-[1.5px] shrink-0 shadow-neon-cyan">
                        <div class="w-full h-full bg-gaming-bg rounded-[10px] flex items-center justify-center text-cyan-400">
                            <i class="fa-solid fa-gamepad text-sm sm:text-base"></i>
                        </div>
                    </div>
                    <span class="font-display font-bold text-xs sm:text-lg tracking-tight text-white truncate">
                        HOANGNAM<span class="text-cyan-400">STORE</span>
                    </span>
                </a>

                <!-- Cụm thao tác bên phải -->
                <div class="flex items-center gap-1 sm:gap-2 shrink-0">
                    <!-- Nút Chi tiết đơn hàng -->
                    <button type="button" onclick="openModal('ordersModal')" title="Chi tiết đơn hàng"
                        class="relative w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-gaming-card hover:bg-gaming-cardHover border border-gaming-border flex items-center justify-center text-slate-300 hover:text-cyan-400 transition-colors">
                        <i class="fa-solid fa-receipt text-xs sm:text-sm"></i>
                        <span id="orderBadgeCount" class="hidden absolute -top-1.5 -right-1.5 min-w-[17px] h-[17px] px-1 rounded-full bg-purple-600 text-white text-[10px] font-bold flex items-center justify-center border border-gaming-bg">0</span>
                    </button>

                    <!-- Khung Số dư + Nút Nạp tiền (+) -->
                    <div class="flex items-center bg-gaming-card border border-amber-500/40 rounded-xl pl-2 pr-1 py-1 gap-1">
                        <span id="headerBalance" class="font-display font-bold text-[11px] sm:text-sm text-amber-400 whitespace-nowrap">0đ</span>
                        <button type="button" onclick="openModal('topupModal')" title="Nạp tiền tài khoản"
                            class="w-6 h-6 sm:w-7 sm:h-7 rounded-lg bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-slate-950 font-extrabold flex items-center justify-center shadow-sm active:scale-95 transition-transform">
                            <i class="fa-solid fa-plus text-[10px] sm:text-xs"></i>
                        </button>
                    </div>

                    <!-- Nút Giỏ hàng -->
                    <button type="button" onclick="openModal('cartModal')" title="Giỏ hàng"
                        class="relative w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-cyan-500/15 hover:bg-cyan-500/25 border border-cyan-500/40 flex items-center justify-center text-cyan-400 transition-colors">
                        <i class="fa-solid fa-cart-shopping text-xs sm:text-sm"></i>
                        <span id="cartBadgeCount" class="absolute -top-1.5 -right-1.5 min-w-[17px] h-[17px] px-1 rounded-full bg-cyan-400 text-slate-950 text-[10px] font-extrabold flex items-center justify-center border border-gaming-bg">0</span>
                    </button>

                    <!-- Nút Avatar (AVT) Đăng nhập / Đăng ký / Thông tin tài khoản -->
                    <button type="button" id="headerAvatarBtn" onclick="openAuthOrProfileModal()" title="Tài khoản của bạn"
                        class="relative flex items-center gap-1.5 p-0.5 sm:pr-2 rounded-full bg-gaming-card hover:bg-gaming-cardHover border border-cyan-500/50 shadow-neon-cyan transition-all active:scale-95">
                        <div id="headerAvatarCircle" class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-gradient-to-br from-cyan-400 via-blue-500 to-purple-600 flex items-center justify-center text-slate-950 font-display font-extrabold text-xs shrink-0">
                            <i class="fa-solid fa-user text-xs"></i>
                        </div>
                        <span id="headerAvatarName" class="hidden sm:inline text-xs font-bold text-slate-200 max-w-[82px] truncate">Tài khoản</span>
                        <span id="headerOnlineDot" class="hidden absolute bottom-0 right-0 sm:right-auto sm:left-6 w-2.5 h-2.5 rounded-full bg-emerald-400 border-2 border-gaming-bg"></span>
                    </button>
                </div>
            </div>

            <!-- Hàng 2: Thanh tìm kiếm nhanh -->
            <div class="mt-2.5 relative">
                <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs sm:text-sm"></i>
                <input type="text" id="searchInput" oninput="filterAndRenderProducts()"
                    placeholder="Tìm Gem, Huge, Titanic, Acc Rank 20..."
                    class="w-full bg-gaming-card/90 border border-gaming-border focus:border-cyan-500/70 rounded-xl pl-9 pr-9 py-2 text-xs sm:text-sm text-white placeholder-slate-400 focus:outline-none transition-colors">
                <button type="button" id="clearSearchBtn" onclick="clearSearch()" class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-white text-xs">
                    <i class="fa-solid fa-circle-xmark"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- ================= 2. NỘI DUNG CHÍNH ================= -->
    <main class="flex-1 max-w-6xl w-full mx-auto px-3 sm:px-5 py-4 space-y-5">

        <!-- Banner Khuyến Mãi & Truy Cập Nhanh -->
        <section class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-[#0c192e] via-[#10223f] to-[#0a1628] border border-cyan-500/30 p-4 sm:p-6 shadow-neon-blue">
            <div class="absolute -right-8 -top-8 w-36 h-36 rounded-full bg-cyan-500/10 blur-2xl pointer-events-none"></div>
            <div class="relative z-10 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="space-y-1.5">
                    <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-cyan-500/15 border border-cyan-400/30 text-cyan-300 text-[11px] font-bold">
                        <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
                        GIAO DỊCH TỰ ĐỘNG 24/7 • UY TÍN HÀNG ĐẦU
                    </div>
                    <h1 class="font-display font-bold text-lg sm:text-2xl text-white leading-snug">
                        SHOP VẬT PHẨM PS99 & <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-400">ACC RANK 20</span>
                    </h1>
                    <p class="text-xs sm:text-sm text-slate-300">
                        Nhập mã <button type="button" onclick="copyText('GIAM10', 'Mã giảm giá GIAM10')" class="px-1.5 py-0.5 rounded bg-amber-500/20 border border-amber-400/40 text-amber-300 font-bold hover:bg-amber-500/30">GIAM10</button> trong giỏ hàng để giảm ngay <strong class="text-cyan-300">10%</strong> tổng đơn!
                    </p>
                </div>
                <div class="flex flex-wrap items-center gap-2 shrink-0">
                    <button type="button" onclick="openModal('topupModal')"
                        class="px-3.5 py-2 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 font-extrabold text-xs sm:text-sm shadow-neon-cyan flex items-center gap-1.5 active:scale-95 transition-transform">
                        <i class="fa-solid fa-qrcode"></i> Nạp Tiền QR
                    </button>
                    <button type="button" onclick="openModal('ordersModal')"
                        class="px-3.5 py-2 rounded-xl bg-gaming-card hover:bg-gaming-cardHover border border-purple-500/40 text-purple-300 font-bold text-xs sm:text-sm flex items-center gap-1.5 transition-colors">
                        <i class="fa-solid fa-receipt"></i> Chi Tiết Đơn Hàng
                    </button>
                </div>
            </div>
        </section>

        <!-- Bộ Lọc Danh Mục, Khoảng Giá & Sắp Xếp -->
        <section class="bg-gaming-card/80 border border-gaming-border rounded-2xl p-3 space-y-2.5">
            <!-- Tabs Danh mục -->
            <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar pb-0.5">
                <button type="button" onclick="setCategory('all')" id="cat-all"
                    class="cat-btn px-3 py-1.5 rounded-xl text-xs font-bold whitespace-nowrap transition-all bg-gradient-to-r from-cyan-500 to-blue-600 text-slate-950 shadow-sm">
                    Tất cả dịch vụ
                </button>
                <button type="button" onclick="setCategory('items')" id="cat-items"
                    class="cat-btn px-3 py-1.5 rounded-xl text-xs font-bold whitespace-nowrap transition-all bg-gaming-bg text-slate-300 border border-gaming-border hover:border-cyan-500/40">
                    <i class="fa-solid fa-gem text-cyan-400 mr-1"></i> Danh Mục Vật Phẩm
                </button>
                <button type="button" onclick="setCategory('accounts')" id="cat-accounts"
                    class="cat-btn px-3 py-1.5 rounded-xl text-xs font-bold whitespace-nowrap transition-all bg-gaming-bg text-slate-300 border border-gaming-border hover:border-amber-500/40">
                    <i class="fa-solid fa-user-shield text-amber-400 mr-1"></i> Danh Mục Acc
                </button>
            </div>

            <!-- Hàng lọc giá & Sắp xếp -->
            <div class="grid grid-cols-2 gap-2 pt-1 border-t border-gaming-border/60">
                <div class="relative">
                    <select id="priceFilter" onchange="filterAndRenderProducts()"
                        class="w-full bg-gaming-bg border border-gaming-border rounded-xl px-2.5 py-2 text-xs text-slate-200 font-medium focus:outline-none focus:border-cyan-500">
                        <option value="all">Khoảng giá: Tất cả</option>
                        <option value="under20">Dưới 20k</option>
                        <option value="20to100">20k - 100k</option>
                        <option value="over100">Trên 100k</option>
                    </select>
                </div>
                <div class="relative">
                    <select id="sortOrder" onchange="filterAndRenderProducts()"
                        class="w-full bg-gaming-bg border border-gaming-border rounded-xl px-2.5 py-2 text-xs text-slate-200 font-medium focus:outline-none focus:border-cyan-500">
                        <option value="default">Sắp xếp: Mặc định</option>
                        <option value="price-asc">Giá: Thấp đến Cao</option>
                        <option value="price-desc">Giá: Cao đến Thấp</option>
                    </select>
                </div>
            </div>
        </section>

        <!-- Khu vực hiển thị 2 Danh mục sản phẩm -->
        <div id="catalogContainer" class="space-y-6">
            <!-- Khu vực 1: DANH MỤC VẬT PHẨM -->
            <section id="section-items" class="space-y-3">
                <div class="flex items-center justify-between gap-2">
                    <div class="flex items-center gap-2.5 min-w-0">
                        <div class="w-9 h-9 rounded-xl bg-cyan-500/15 border border-cyan-500/40 flex items-center justify-center text-cyan-400 shrink-0">
                            <i class="fa-solid fa-gem text-base"></i>
                        </div>
                        <div class="min-w-0">
                            <h2 class="font-display font-bold text-base sm:text-lg text-white tracking-wide truncate">DANH MỤC VẬT PHẨM</h2>
                            <p class="text-[11px] sm:text-xs text-slate-400 truncate">Gem, Huge, Titanic giao nhanh qua Trade / Mail</p>
                        </div>
                    </div>
                    <span id="count-items" class="px-2.5 py-1 rounded-lg bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-[11px] font-bold whitespace-nowrap shrink-0">3 Gói</span>
                </div>
                <div id="grid-items" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5"></div>
            </section>

            <!-- Khu vực 2: DANH MỤC ACC -->
            <section id="section-accounts" class="space-y-3">
                <div class="flex items-center justify-between gap-2">
                    <div class="flex items-center gap-2.5 min-w-0">
                        <div class="w-9 h-9 rounded-xl bg-amber-500/15 border border-amber-500/40 flex items-center justify-center text-amber-400 shrink-0">
                            <i class="fa-solid fa-user-shield text-base"></i>
                        </div>
                        <div class="min-w-0">
                            <h2 class="font-display font-bold text-base sm:text-lg text-white tracking-wide truncate">DANH MỤC ACC</h2>
                            <p class="text-[11px] sm:text-xs text-slate-400 truncate">Tài khoản cày sẵn Rank 20 • Trắng thông tin</p>
                        </div>
                    </div>
                    <span id="count-accounts" class="px-2.5 py-1 rounded-lg bg-amber-500/10 border border-amber-500/30 text-amber-300 text-[11px] font-bold whitespace-nowrap shrink-0">1 Gói</span>
                </div>
                <div id="grid-accounts" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5"></div>
            </section>
        </div>

        <!-- Trạng thái không tìm thấy kết quả -->
        <div id="emptyState" class="hidden text-center py-12 px-4 rounded-2xl bg-gaming-card border border-gaming-border space-y-3">
            <div class="w-12 h-12 rounded-2xl bg-slate-800/80 text-slate-400 flex items-center justify-center mx-auto text-xl">
                <i class="fa-solid fa-box-open"></i>
            </div>
            <p class="font-bold text-sm text-white">Không tìm thấy vật phẩm phù hợp</p>
            <p class="text-xs text-slate-400">Hãy thử từ khóa khác hoặc đặt lại bộ lọc giá.</p>
            <button type="button" onclick="resetFilters()" class="px-4 py-2 rounded-xl bg-cyan-500 text-slate-950 font-bold text-xs">
                Xem tất cả dịch vụ
            </button>
        </div>
    </main>

    <!-- ================= 3. CHÂN TRANG (FOOTER) & LIÊN HỆ THẲNG HÀNG ================= -->
    <footer id="footerContact" class="mt-8 border-t border-gaming-border bg-[#05070c]">
        <div class="max-w-6xl mx-auto px-3 sm:px-5 py-6 space-y-5">
            <!-- Giới thiệu ngắn -->
            <div class="space-y-2">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-xl bg-cyan-500/15 border border-cyan-500/40 flex items-center justify-center text-cyan-400">
                        <i class="fa-solid fa-gamepad text-sm"></i>
                    </div>
                    <span class="font-display font-bold text-base text-white">HOANGNAM<span class="text-cyan-400">STORE</span></span>
                </div>
                <p class="text-xs text-slate-400 leading-relaxed">
                    Hệ thống cung cấp vật phẩm game (Gem, Huge, Titanic) và tài khoản Rank 20 uy tín, giá tốt nhất thị trường. Hỗ trợ giao hàng nhanh chóng & bảo hành tận tâm.
                </p>
            </div>

            <!-- Khu vực Liên hệ hỗ trợ trực tiếp xếp dọc thẳng hàng cân đối -->
            <div class="space-y-2.5">
                <h3 class="font-display font-bold text-xs uppercase tracking-wider text-slate-300">LIÊN HỆ HỖ TRỢ TRỰC TIẾP</h3>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-2.5">
                    <!-- Thẻ 1: Facebook Admin -->
                    <a href="https://www.facebook.com/share/1F3LZ13LX5/" target="_blank" rel="noopener noreferrer"
                        onclick="openExternalLink(event, 'https://www.facebook.com/share/1F3LZ13LX5/')"
                        class="w-full flex items-center justify-between gap-3 p-3 rounded-2xl bg-gaming-card hover:bg-gaming-cardHover border border-gaming-border hover:border-blue-500/50 transition-all">
                        <div class="flex items-center gap-3 min-w-0">
                            <div class="w-10 h-10 rounded-xl bg-blue-600/20 border border-blue-500/40 flex items-center justify-center text-blue-400 shrink-0">
                                <i class="fa-brands fa-facebook-f text-lg"></i>
                            </div>
                            <div class="min-w-0">
                                <div class="font-bold text-xs sm:text-sm text-white flex items-center gap-1.5">
                                    <span>Facebook Admin</span>
                                    <i class="fa-solid fa-arrow-up-right-from-square text-[10px] text-cyan-400"></i>
                                </div>
                                <p class="text-[11px] text-slate-400 truncate">Nhấn để mở trang FB trực tiếp</p>
                            </div>
                        </div>
                        <span class="px-2.5 py-1.5 rounded-xl bg-blue-500/15 border border-blue-500/30 text-blue-300 text-[11px] font-bold shrink-0">
                            Mở FB
                        </span>
                    </a>

                    <!-- Thẻ 2: SĐT / Zalo Hỗ Trợ (Chỉ có nút Copy 1 chạm) -->
                    <div class="w-full flex items-center justify-between gap-3 p-3 rounded-2xl bg-gaming-card border border-gaming-border">
                        <div class="flex items-center gap-3 min-w-0">
                            <div class="w-10 h-10 rounded-xl bg-emerald-500/15 border border-emerald-500/40 flex items-center justify-center text-emerald-400 shrink-0">
                                <i class="fa-solid fa-phone-volume text-base"></i>
                            </div>
                            <div class="min-w-0">
                                <div class="text-[11px] text-slate-400 font-medium">SĐT / Zalo Hỗ Trợ</div>
                                <div class="font-display font-bold text-sm sm:text-base text-emerald-400 tracking-wide">0783167978</div>
                            </div>
                        </div>
                        <button type="button" onclick="copyText('0783167978', 'Số điện thoại / Zalo 0783167978')"
                            class="px-3 py-2 rounded-xl bg-emerald-500/15 hover:bg-emerald-500/25 border border-emerald-500/40 text-emerald-300 text-xs font-bold flex items-center gap-1.5 shrink-0 active:scale-95 transition-transform">
                            <i class="fa-regular fa-copy"></i> Copy
                        </button>
                    </div>
                </div>
            </div>

            <!-- Dòng Bản Quyền Năm 2026 -->
            <div class="pt-4 border-t border-gaming-border/70 text-center space-y-1 text-xs text-slate-400">
                <p>© 2026 <strong class="text-white">HoangNam Store</strong>. All rights reserved.</p>
                <p>Hỗ trợ khách hàng: <span class="font-bold text-emerald-400">0783167978</span></p>
            </div>
        </div>
    </footer>

    <!-- ================= 4. MODAL ĐĂNG NHẬP / ĐĂNG KÝ & THÔNG TIN TÀI KHOẢN (AVT) ================= -->
    <div id="authModal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-end sm:items-center justify-center p-0 sm:p-4">
        <div class="w-full max-w-md bg-gaming-card border-t sm:border border-gaming-border rounded-t-3xl sm:rounded-3xl max-h-[92vh] flex flex-col overflow-hidden shadow-2xl">
            <!-- Header Modal -->
            <div class="px-4 py-3.5 border-b border-gaming-border flex items-center justify-between shrink-0">
                <div class="flex items-center gap-2">
                    <div class="w-7 h-7 rounded-full bg-gradient-to-br from-cyan-400 to-purple-600 flex items-center justify-center text-slate-950 text-xs font-bold">
                        <i class="fa-solid fa-user-astronaut"></i>
                    </div>
                    <h3 id="authModalTitle" class="font-display font-bold text-sm sm:text-base text-white">TÀI KHOẢN HOANGNAM STORE</h3>
                </div>
                <button type="button" onclick="closeModal('authModal')" class="w-8 h-8 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 flex items-center justify-center">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- Body Modal -->
            <div class="p-4 overflow-y-auto space-y-4">
                <!-- KHU VỰC 1: CHƯA ĐĂNG NHẬP (TABS ĐĂNG NHẬP / ĐĂNG KÝ) -->
                <div id="authGuestContainer" class="space-y-4">
                    <div class="grid grid-cols-2 gap-2 p-1 rounded-2xl bg-gaming-bg border border-gaming-border">
                        <button type="button" id="tabLoginBtn" onclick="switchAuthTab('login')"
                            class="py-2 px-3 rounded-xl text-xs font-extrabold bg-gradient-to-r from-cyan-500 to-blue-600 text-slate-950 transition-all">
